rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Propriétaire de l'application (compte E-mail / mot de passe créé dans Firebase Authentication)
    function isAdmin() { return request.auth != null && request.auth.token.email == 'azizyou2005@yahoo.fr'; }
    // Un utilisateur ne peut utiliser la ferme partagée qu'après l'accord du propriétaire
    function approved() { return request.auth != null
      && get(/databases/$(database)/documents/inscriptions/$(request.auth.uid)).data.statut == 'approuve'; }
    function txt(v, n) { return v is string && v.size() <= n; }
    // Photo : vide, ou image intégrée (JPEG/PNG/WebP en base64) de taille limitée. Jamais d'adresse web
    // (une image distante permettrait de suivre les personnes qui la regardent).
    function img(v, n) { return v == '' || (v is string && v.size() <= n
      && v.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$')); }
    function devises() { return ['XOF','XAF','EUR','USD','NGN','GHS','GNF','MAD','GBP','CAD']; }

    // Demandes de suppression du compte (exigence Google Play) : l'utilisateur crée la sienne, seul B2A la lit
    match /suppressions/{uid} {
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['demandeLe','appareil','ferme','nom','statut'])
        && request.resource.data.statut == 'demande' && txt(request.resource.data.nom, 80);
      allow read, delete: if isAdmin();
    }

    // Inscriptions : une par téléphone (identifiant anonyme Firebase). L'accès est accordé à l'inscription ;
    // le propriétaire peut le retirer (statut 'bloque').
    match /inscriptions/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.statut == 'approuve'
        && request.resource.data.keys().hasOnly(['prenom','nom','ville','pays','elevage','taille','statut','creeLe','vuLe','plateforme','langue','version','appareil'])
        && txt(request.resource.data.prenom, 60) && txt(request.resource.data.nom, 60)
        && txt(request.resource.data.ville, 60) && txt(request.resource.data.pays, 60)
        && txt(request.resource.data.elevage, 60) && txt(request.resource.data.taille, 60);
      // l'utilisateur ne peut changer que sa date de dernière ouverture ; seul le propriétaire peut retirer ou rendre l'accès
      // + e-mail du compte (facultatif, égal à l'e-mail de connexion) et code de la ferme, pour retrouver la ferme après une réinstallation
      allow update: if isAdmin() || (request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vuLe','version','plateforme','email','ferme'])
        && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email)
        && (!('ferme' in request.resource.data) || validCode(request.resource.data.ferme)));
      allow delete: if isAdmin();
    }

    // ---------- Fermes partagées ----------
    // farms/<code> : { owner: identifiant Firebase du téléphone propriétaire, approbation: true/false }
    // farms/<code>/members/<uid> : { name, dev, role: 'proprietaire'|'employe', statut: 'actif'|'attente'|'retire', vu, creeLe }
    // Une ferme sans document farms/<code> (créée avant le système de propriétaire) reste ouverte à qui connaît le code.
    function validCode(farm) { return farm.matches('^[A-Z0-9]{10}$'); }
    function hasOwner(farm) { return exists(/databases/$(database)/documents/farms/$(farm)); }
    function farmData(farm) { return get(/databases/$(database)/documents/farms/$(farm)).data; }
    function isOwner(farm) { return request.auth != null && hasOwner(farm) && farmData(farm).owner == request.auth.uid; }
    function activeMember(farm) {
      return request.auth != null
        && exists(/databases/$(database)/documents/farms/$(farm)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/farms/$(farm)/members/$(request.auth.uid)).data.statut == 'actif';
    }
    function canUse(farm) { return approved() && validCode(farm) && (!hasOwner(farm) || isOwner(farm) || activeMember(farm)); }

    // Fiche de la ferme : lisible avec le code exact (jamais de liste), modifiable seulement par le propriétaire.
    match /farms/{farm} {
      allow get: if approved() && validCode(farm);
      allow create: if approved() && validCode(farm)
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['owner', 'approbation', 'creeLe'])
        && request.resource.data.get('approbation', false) is bool;
      allow update: if approved() && resource.data.owner == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approbation'])
        && request.resource.data.approbation is bool;
    }

    // Équipe : chacun s'inscrit lui-même ; seul le propriétaire accepte, retire ou réintègre.
    match /farms/{farm}/members/{uid} {
      allow read: if canUse(farm) || (approved() && validCode(farm) && request.auth.uid == uid);
      allow create: if approved() && validCode(farm) && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'dev', 'role', 'statut', 'vu', 'creeLe'])
        && txt(request.resource.data.get('name', ''), 60) && txt(request.resource.data.get('dev', ''), 40)
        && (
          (isOwner(farm) && request.resource.data.role == 'proprietaire' && request.resource.data.statut == 'actif')
          || (!isOwner(farm) && request.resource.data.role == 'employe'
              && (request.resource.data.statut == 'attente'
                  || (request.resource.data.statut == 'actif' && (!hasOwner(farm) || farmData(farm).get('approbation', false) == false))))
        );
      allow update: if (approved() && isOwner(farm))
        || (approved() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'vu', 'dev'])
            && txt(request.resource.data.get('name', ''), 60));
      allow delete: if approved() && isOwner(farm);
    }

    // Données de la ferme : farms/<code>/<collection>/<document>, pour le propriétaire et les membres actifs.
    // Il n'existe aucune règle pour lister "farms" : personne ne peut voir la liste des fermes ni leurs codes.
    match /farms/{farm}/{col}/{doc} {
      allow read, write: if canUse(farm)
        && col in ['lots', 'saisies', 'soins', 'analyses', 'previsions', 'formules', 'factures', 'reglages', 'contacts', 'depenses', 'couveuses', 'couvees'];
    }

    // ---------- Marché B2A (partie payante) ----------
    // Tout utilisateur inscrit voit les annonces ; seuls les vendeurs actifs publient ; B2A (isAdmin) gère tout.
    function seller() { return request.auth != null
      && get(/databases/$(database)/documents/marche_vendeurs/$(request.auth.uid)).data.statut == 'actif'; }
    function mcfg() { return get(/databases/$(database)/documents/marche_config/global).data; }
    function cmdAvant(c) { return get(/databases/$(database)/documents/marche_commandes/$(c)).data; }
    function cmdApres(c) { return getAfter(/databases/$(database)/documents/marche_commandes/$(c)).data; }
    function tauxB2A() { return exists(/databases/$(database)/documents/marche_config/global) ? mcfg().get('taux', 5) : 5; }

    match /marche_config/{id} {
      allow read: if approved() || isAdmin();
      allow write: if isAdmin();
    }
    // Ouverture de la boutique : le vendeur accepte le taux de commission en vigueur ; seul B2A peut suspendre ou changer le taux.
    match /marche_vendeurs/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create: if approved() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['statut','nom','tel','ville','taux','accepteLe','cgu','cguLe'])
        && request.resource.data.statut == 'actif' && request.resource.data.taux == tauxB2A()
        && txt(request.resource.data.nom, 60) && txt(request.resource.data.tel, 30) && txt(request.resource.data.ville, 60);
      allow update: if isAdmin() || (approved() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nom','tel','ville','cgu','cguLe'])
        && txt(request.resource.data.nom, 60) && txt(request.resource.data.tel, 30) && txt(request.resource.data.ville, 60));
      allow delete: if isAdmin();
    }
    // Fiche publique de l'entreprise : la seule information du vendeur visible par les acheteurs (nom, activité, lieu, contact).
    // Les données de gestion (lots, saisies, ventes, commissions…) restent dans farms/<code> ou marche_vendeurs, jamais lisibles par les acheteurs.
    match /marche_boutiques/{uid} {
      allow read: if approved() || isAdmin();
      // le badge « verifie » est posé seulement par B2A (isAdmin) après contrôle de la pièce
      allow write: if isAdmin();
      allow create, update: if approved() && request.auth.uid == uid && seller()
        && request.resource.data.keys().hasOnly(['nom','activite','ville','quartier','tel','horaires','desc','majLe','verifie'])
        && request.resource.data.get('verifie', false) == (resource == null ? false : resource.data.get('verifie', false))
        && request.resource.data.get('tel', '') == ''   // pas de téléphone public : il est donné au client après acceptation
        && txt(request.resource.data.nom, 60) && txt(request.resource.data.get('activite',''), 60) && txt(request.resource.data.ville, 60)
        && txt(request.resource.data.get('quartier',''), 60) && txt(request.resource.data.tel, 30) && txt(request.resource.data.get('horaires',''), 60)
        && txt(request.resource.data.get('desc',''), 400);
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }
    // Pièce justificative (CNIB, ou RCCM + IFU) : privée, lisible seulement par le vendeur et B2A ; seul B2A la valide ou la refuse.
    match /marche_pieces/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if isAdmin();
      allow create, update: if approved() && request.auth.uid == uid
        && (resource == null || resource.data.statut != 'validee')
        && request.resource.data.keys().hasOnly(['type','titulaire','cnib','rccm','ifu','photo','statut','motif','envoyeLe'])
        && request.resource.data.statut == 'attente' && request.resource.data.type in ['cnib','entreprise']
        && txt(request.resource.data.titulaire, 80) && txt(request.resource.data.cnib, 20) && txt(request.resource.data.rccm, 40) && txt(request.resource.data.ifu, 20)
        && img(request.resource.data.photo, 400000) && request.resource.data.photo != '';
    }
    function annonceOk(d) { return d.keys().hasOnly(['devise','vendeur','vendeurNom','vendeurTel','ville','cat','titre','desc','prix','unite','qte','photo','statut','creeLe','majLe','derniereCommande'])
      && d.statut in ['actif','epuise','retire']
      && txt(d.titre, 80) && txt(d.get('desc',''), 600) && txt(d.get('vendeurNom',''), 60) && txt(d.get('ville',''), 60)
      && txt(d.get('cat',''), 20) && txt(d.get('unite',''), 30) && d.get('devise','XOF') in devises()
      && d.prix is number && d.prix > 0 && d.prix < 1000000000000
      && (d.get('qte', null) == null || (d.qte is number && d.qte >= 0))
      && img(d.get('photo',''), 400000); }
    match /marche_annonces/{id} {
      allow read: if approved() || isAdmin();
      allow create: if approved() && seller() && request.resource.data.vendeur == request.auth.uid
        && request.resource.data.get('vendeurTel', '') == ''
        && annonceOk(request.resource.data);
      allow update: if isAdmin() || (approved() && seller() && resource.data.vendeur == request.auth.uid
        && request.resource.data.vendeur == request.auth.uid
        && request.resource.data.get('vendeurTel', '') == ''
        && annonceOk(request.resource.data));
      // Stock réservé par l'acheteur : la quantité baisse seulement du nombre commandé dans une NOUVELLE commande
      // de cet acheteur (écrite dans la même transaction), et revient quand il annule sa demande.
      allow update: if approved() && resource.data.vendeur != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qte','statut','majLe','derniereCommande'])
        && request.resource.data.qte is number && request.resource.data.qte >= 0
        && request.resource.data.statut == (request.resource.data.qte <= 0 ? 'epuise' : (resource.data.statut == 'epuise' ? 'actif' : resource.data.statut))
        && (
          (!exists(/databases/$(database)/documents/marche_commandes/$(request.resource.data.derniereCommande))
            && cmdApres(request.resource.data.derniereCommande).annonce == id
            && cmdApres(request.resource.data.derniereCommande).acheteur == request.auth.uid
            && cmdApres(request.resource.data.derniereCommande).statut == 'demande'
            && cmdApres(request.resource.data.derniereCommande).reserve == true
            && resource.data.statut == 'actif'
            && request.resource.data.qte == resource.data.qte - cmdApres(request.resource.data.derniereCommande).qte)
          || (cmdAvant(request.resource.data.derniereCommande).annonce == id
            && cmdAvant(request.resource.data.derniereCommande).acheteur == request.auth.uid
            && cmdAvant(request.resource.data.derniereCommande).statut == 'demande'
            && cmdAvant(request.resource.data.derniereCommande).get('reserve', false) == true
            && cmdApres(request.resource.data.derniereCommande).statut == 'annulee'
            && request.resource.data.qte == resource.data.qte + cmdAvant(request.resource.data.derniereCommande).qte)
        );
    }
    // Commandes : l'acheteur crée la demande ; le vendeur accepte, refuse ou déclare la vente (avec la commission B2A) ;
    // l'acheteur peut annuler tant que la demande n'est pas acceptée.
    // Commandes : l'acheteur crée la demande SANS ses coordonnées (elles vont dans marche_contacts) ;
    // le vendeur accepte (la commission B2A est due dès l'acceptation et ne peut plus baisser), refuse,
    // déclare la vente ou annule ; l'acheteur peut annuler tant que la demande n'est pas acceptée.
    function tauxVendeur() { return get(/databases/$(database)/documents/marche_vendeurs/$(request.auth.uid)).data.taux; }
    match /marche_commandes/{id} {
      allow read: if isAdmin() || (request.auth != null && (resource.data.acheteur == request.auth.uid || resource.data.vendeur == request.auth.uid));
      allow create: if approved() && request.resource.data.acheteur == request.auth.uid && request.resource.data.statut == 'demande'
        && request.resource.data.total is number
        // le prix et le vendeur viennent de l'annonce : l'acheteur ne peut pas les changer
        && request.resource.data.vendeur == get(/databases/$(database)/documents/marche_annonces/$(request.resource.data.annonce)).data.vendeur
        && request.resource.data.prix == get(/databases/$(database)/documents/marche_annonces/$(request.resource.data.annonce)).data.prix
        && request.resource.data.qte is number && request.resource.data.qte > 0
        && request.resource.data.total >= request.resource.data.qte * request.resource.data.prix - 0.011
        && request.resource.data.total <= request.resource.data.qte * request.resource.data.prix + 0.011
        && !request.resource.data.keys().hasAny(['acheteurNom','acheteurTel','note','commission','accepteLe','commAnnulee'])
        && request.resource.data.get('vendeurTel', '') == '';
      allow update: if isAdmin()
        || (request.auth != null && resource.data.vendeur == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut','taux','commission','venduLe','accepteLe','vendeurTel','majLe'])
            // le téléphone du vendeur n'est donné au client qu'à l'acceptation
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['vendeurTel']) || request.resource.data.statut == 'acceptee')
            && request.resource.data.statut in ['acceptee','refusee','vendue','annulee']
            // acceptation : seulement depuis une demande, avec la commission au taux du vendeur
            && (request.resource.data.statut != 'acceptee' || resource.data.statut == 'acceptee'
                || (resource.data.statut == 'demande' && request.resource.data.commission is number
                    && request.resource.data.commission >= resource.data.total * tauxVendeur() / 100 - 0.01))
            && (request.resource.data.statut != 'refusee' || resource.data.statut == 'demande')
            && (request.resource.data.statut != 'vendue' || resource.data.statut == 'acceptee')
            // une commission fixée ne baisse jamais ; si elle est posée à la vente (anciennes commandes), elle respecte le taux
            && (resource.data.get('commission', 0) == 0
                ? (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['commission'])
                   || request.resource.data.commission >= resource.data.total * tauxVendeur() / 100 - 0.01)
                : request.resource.data.get('commission', 0) == resource.data.commission))
        || (request.auth != null && resource.data.acheteur == request.auth.uid && resource.data.statut == 'demande'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut','majLe'])
            && request.resource.data.statut == 'annulee');
      allow delete: if isAdmin();
    }
    // Coordonnées de l'acheteur pour une commande : lisibles par l'acheteur, par B2A, et par le vendeur
    // SEULEMENT après qu'il a accepté la commande (accepteLe posé).
    match /marche_contacts/{id} {
      allow read: if isAdmin() || (request.auth != null && (resource.data.acheteur == request.auth.uid
        || (resource.data.vendeur == request.auth.uid
            && get(/databases/$(database)/documents/marche_commandes/$(id)).data.get('accepteLe', null) != null)));
      allow create: if approved() && request.resource.data.acheteur == request.auth.uid
        && getAfter(/databases/$(database)/documents/marche_commandes/$(id)).data.acheteur == request.auth.uid
        && getAfter(/databases/$(database)/documents/marche_commandes/$(id)).data.vendeur == request.resource.data.vendeur
        && request.resource.data.keys().hasOnly(['acheteur','vendeur','nom','tel','ville','note','creeLe'])
        && txt(request.resource.data.nom, 60) && txt(request.resource.data.tel, 30)
        && txt(request.resource.data.get('ville',''), 60) && txt(request.resource.data.get('note',''), 200);
      allow update, delete: if isAdmin();
    }
    // Paiements de commission : enregistrés par B2A, visibles par le vendeur concerné.
    match /marche_paiements/{id} {
      allow read: if isAdmin() || (request.auth != null && resource.data.vendeur == request.auth.uid);
      allow write: if isAdmin();
    }

    // ---------- Services : vétérinaires et prestataires (inscription payante) ----------
    // Le prestataire crée sa fiche (statut 'attente') et déclare son paiement ; seul B2A met en ligne (statut 'actif' + finLe),
    // marque « vérifié », suspend ou refuse. Les éleveurs voient seulement les fiches 'actif' (l'application cache celles dont finLe est passée).
    function svcChamps() { return ['nom','metier','specialites','ville','quartier','zones','tel','wa','horaires','deplace','agrement','desc','photo']; }
    function svcFiche(d) { return txt(d.nom, 60) && txt(d.metier, 20) && txt(d.get('specialites',''), 100) && txt(d.ville, 60)
      && txt(d.get('quartier',''), 60) && txt(d.get('zones',''), 100) && txt(d.tel, 30) && txt(d.get('wa',''), 30)
      && txt(d.get('horaires',''), 60) && d.get('deplace', false) is bool && txt(d.get('agrement',''), 40)
      && txt(d.get('desc',''), 400) && img(d.get('photo',''), 200000); }
    match /services_pros/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid) || (approved() && resource.data.statut == 'actif');
      allow create: if approved() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(svcChamps().concat(['statut','creeLe','majLe']))
        && request.resource.data.statut == 'attente' && svcFiche(request.resource.data);
      allow update: if isAdmin() || (approved() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(svcChamps().concat(['majLe']))
        && svcFiche(request.resource.data));
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }
    // Paiements d'abonnement : déclarés par le prestataire (référence Orange Money / Moov Money), validés ou refusés par B2A.
    match /services_paiements/{id} {
      allow read: if isAdmin() || (request.auth != null && resource.data.pro == request.auth.uid);
      allow create: if approved() && request.resource.data.pro == request.auth.uid
        && exists(/databases/$(database)/documents/services_pros/$(request.auth.uid))
        && request.resource.data.keys().hasOnly(['pro','nom','formule','mois','montant','ref','telPayeur','statut','creeLe'])
        && request.resource.data.statut == 'attente'
        && request.resource.data.formule in ['m1','m3','m12'] && request.resource.data.mois in [1,3,12]
        && request.resource.data.montant is number && request.resource.data.montant > 0
        && txt(request.resource.data.ref, 40) && txt(request.resource.data.telPayeur, 30) && txt(request.resource.data.get('nom',''), 60);
      allow update, delete: if isAdmin();
    }

    // ---------- Erreurs de l'application ----------
    // Chaque téléphone peut signaler une erreur technique (message court, sans données de la ferme) ; seul B2A les lit et les efface.
    match /erreurs/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['msg','src','pile','version','plateforme','langue','ecran','nb','creeLe'])
        && txt(request.resource.data.msg, 300) && txt(request.resource.data.get('src',''), 200) && txt(request.resource.data.get('pile',''), 1500)
        && txt(request.resource.data.get('version',''), 20) && txt(request.resource.data.get('plateforme',''), 30)
        && txt(request.resource.data.get('langue',''), 5) && txt(request.resource.data.get('ecran',''), 30)
        && request.resource.data.get('nb', 1) is int && request.resource.data.get('nb', 1) <= 100;
      allow read, delete: if isAdmin();
    }
  }
}
